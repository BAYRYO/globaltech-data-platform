# Copy to .env (git-ignored) to override cluster settings; docker compose reads it.
# Memory budget: docs/platform.md, section "Budget mémoire".

# Memory and vcores each of the 2 NodeManagers offers to YARN containers, and the largest
# container YARN accepts. Spark defaults need 2560 (AM 1 GB + one 1.5 GB executor per node).
YARN_NM_MEMORY_MB=2560
YARN_NM_VCORES=4
